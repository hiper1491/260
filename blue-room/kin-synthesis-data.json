{
  "version": "2026-01-19",
  "lang": "zh-TW",
  "notes": {
    "design_intent": "維持你目前『高頻/低頻/調頻行動』的引導語氣；圖騰僅保留你實用的核心層；額外補上每圖騰 5 組關鍵詞、每調性 3 組動詞，便於三卡合盤句生成。"
  },
  "placeholders": {
    "{PAST_TONE}": "過去調性名稱",
    "{PAST_SEAL}": "過去圖騰名稱",
    "{PAST_KW_A}": "過去圖騰關鍵詞A(從 seal_keywords 擇一)",
    "{PRESENT_TONE}": "現在調性名稱",
    "{PRESENT_SEAL}": "現在圖騰名稱",
    "{PRESENT_VERB}": "現在調性動詞(從 tone_verbs 擇一)",
    "{PRESENT_KW_B}": "現在圖騰關鍵詞B(從 seal_keywords 擇一)",
    "{FUTURE_TONE}": "未來調性名稱",
    "{FUTURE_SEAL}": "未來圖騰名稱",
    "{FUTURE_STATE}": "未來調性狀態(建議用 tones[future].high_freq or key_feel)",
    "{FUTURE_KW_C}": "未來圖騰關鍵詞C(從 seal_keywords 擇一)",
    "{THEME}": "主題提煉(從三張 core 或 keywords 萃取)"
  },


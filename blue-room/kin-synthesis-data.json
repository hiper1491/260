  "blue_temple_three_card_templates": {
    "style": "神聖但不艱澀；詩意但具體；適合 60-80 字左右的合盤金句。",
    "templates": [
      {
        "id": "BT3_v1_classic",
        "name": "經典合盤句（你原本的公式版）",
        "pattern": "從【{PAST_SEAL}】的【{PAST_KW_A}】出發，經由【{PRESENT_TONE}】的【{PRESENT_VERB}】，在【{PRESENT_SEAL}】的【{PRESENT_KW_B}】裡校準方向，正流向【{FUTURE_SEAL}】的【{FUTURE_KW_C}】與【{FUTURE_STATE}】。你的時間之流正在編織一段關於【{THEME}】的旅程。"
      },
      {
        "id": "BT3_v2_soft_ritual",
        "name": "柔和儀式版（更像引導者口吻）",
        "pattern": "你已走過【{PAST_SEAL}】的【{PAST_KW_A}】，現在讓【{PRESENT_TONE}】帶你【{PRESENT_VERB}】，把心放進【{PRESENT_SEAL}】的【{PRESENT_KW_B}】裡。接下來，你會更自然地進入【{FUTURE_SEAL}】的【{FUTURE_KW_C}】，抵達【{FUTURE_STATE}】——這就是【{THEME}】正在成形的方式。"
      },
      {
        "id": "BT3_v3_minimal_strong",
        "name": "極簡強句版（短、穩、可做 UI 主句）",
        "pattern": "從【{PAST_KW_A}】到【{PRESENT_VERB}】，你在【{PRESENT_KW_B}】裡轉向，並走向【{FUTURE_KW_C}】的【{FUTURE_STATE}】；主題是【{THEME}】。"
      },
      {
        "id": "BT3_v4_two_lines_ui",
        "name": "雙行 UI 版（上句敘事＋下句落地）",
        "pattern": "上句：從【{PAST_SEAL}】的【{PAST_KW_A}】，經由【{PRESENT_TONE}】的【{PRESENT_VERB}】，走向【{FUTURE_SEAL}】的【{FUTURE_KW_C}】。\n下句：把主題收束成一句——【{THEME}】；此刻只要先做到：套用【{PRESENT_TONE}】的調頻行動（tones[{PRESENT_TONE}].align_action）。"
      }
    ],
    "theme_extraction_hint": {
      "rule": "THEME 建議從三張的 core 各取一個名詞片段，再做 6-10 字提煉",
      "example": "（被支持）＋（完成療癒）＋（無條件的愛）→「在被支持中完成療癒，回到愛」"
    }
  }
